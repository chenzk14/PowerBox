    <!-- 分：两位（00-59） -->
    <string name="clock_format_minute">mm</string>
    <!-- 日期：如 6日 周五（EEEE 显示"周五"，单引号内为原样输出的中文） -->
    <string name="clock_format_date">d\'日\' EEE</string>
