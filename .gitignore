# Flutter build output
# 根目录 build/ 已在上方 Flutter/Dart/Pub related 中统一忽略，此处不再重复声明

# Platform specific
/android/.cxx/
/android/app/.cxx/
# Gradle wrapper：gradle-wrapper.properties 需要提交以锁定 Gradle 版本，
# jar 与启动脚本由 Flutter 在构建时自动生成，因此不纳入版本控制
/android/gradle/wrapper/gradle-wrapper.jar
/android/gradlew
/android/gradlew.bat

# Generated pluginRegistrant
/**/GeneratedPluginRegistrant.java
/**/GeneratedPluginRegistrant.kt

# Podfile (if not committed)
/ios/Pods/
/ios/.symlinks/

